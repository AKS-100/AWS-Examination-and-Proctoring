NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive_exam_db

# Authentication (Phase 1)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# AWS Free Tier Services Integration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=

# Amazon S3 (5 GB Free Storage: Evidence snapshots & candidate ID bucket)
AWS_S3_BUCKET=adaptive-exam-proctoring-evidence

# Amazon Cognito (50,000 MAUs Free: User Pool & Client IDs)
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Lambda (1M free invocations/month: Async Proctoring Incident Evaluator)
AWS_LAMBDA_EVALUATOR_ARN=arn:aws:lambda:us-east-1:123456789012:function:proctoring-incident-evaluator

# Amazon SNS (1M free publishes/month: Real-time High Risk Proctor Alerts)
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:proctor-high-risk-alerts
